{
  "name": "aura-desktop",
  "version": "1.0.4",
  "description": "Aura — a local memory-native desktop companion with live transcription, screen context, voice, and optional local AI providers",
  "main": "./out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "package": "npm run package:win",
    "package:win": "electron-vite build && electron-builder --win --publish never",
    "package:mac": "electron-vite build && electron-builder --mac --publish never",
    "package:all": "electron-vite build && electron-builder --win --mac --publish never",
    "package:dir": "electron-vite build && electron-builder --dir --publish never",
    "check:local-ai": "node scripts/check-local-ai-config.mjs && node scripts/check-local-ai-routing.mjs && node scripts/check-whisper-runtime.mjs",
    "check:package": "node scripts/check-package-config.mjs",
    "check:session-brain-cleanup": "node scripts/check-session-brain-screenshot-cleanup.mjs",
    "check:session-report": "node scripts/check-session-report-artifact.mjs",
    "check:companion-turn-boundaries": "node scripts/check-companion-turn-boundaries.mjs",
    "check:detail-dedupe": "node scripts/check-detail-answer-dedupe.mjs",
    "check:detail-empty-done": "node scripts/check-detail-empty-done-preserves-content.mjs",
    "check:session-brain-dedupe": "node scripts/check-session-brain-screenshot-dedupe.mjs",
    "check:freellmapi-provider": "node scripts/check-freellmapi-provider-config.mjs",
    "check:companion-realtime": "node scripts/check-companion-realtime-pipeline.mjs",
    "check:release-version": "node scripts/check-release-version.mjs",
    "check:release": "npm run check:release-version && npm run check:package && npm run check:session-brain-cleanup && npm run check:session-report && npm run check:companion-turn-boundaries && npm run check:detail-dedupe && npm run check:detail-empty-done && npm run check:session-brain-dedupe && npm run check:freellmapi-provider && npm run check:companion-realtime && npm run build"
  },
  "build": {
    "appId": "com.aura.desktop",
    "productName": "Aura",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity"
    },
    "dmg": {
      "title": "Aura",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aura",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!models/**",
      "!model-packs/**",
      "!resources/models/**",
      "!resources/model-packs/**",
      "!**/*.gguf",
      "!**/*.safetensors",
      "!**/*.onnx",
      "!**/*.bin",
      "!**/*.pt",
      "!**/*.pth"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "resources/workspace-skills",
        "to": "workspace-skills",
        "filter": [
          "**/*.md",
          "!**/*.gguf",
          "!**/*.safetensors",
          "!**/*.onnx",
          "!**/*.bin",
          "!**/*.pt",
          "!**/*.pth"
        ]
      }
    ]
  },
  "keywords": [
    "ai",
    "assistant",
    "desktop-agent",
    "local-ai",
    "memory",
    "voice",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@deepgram/sdk": "^5.0.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@xenova/transformers": "^2.17.2",
    "dotenv": "^17.3.1",
    "electron-store": "^11.0.2",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.577.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
